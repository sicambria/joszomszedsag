APP_NAME=Joszomszedseg
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
APP_LOCALE=hu
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=joszomszedsag
DB_USERNAME=root
DB_PASSWORD=change-me-in-production

BROADCAST_CONNECTION=log
CACHE_STORE=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true

REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

SITE_TITLE="Jószomszédság Vigyázó Hálózata"
SITE_DESCRIPTION="Segíts a szomszédodnak!"
SITE_LOGO=/images/logo.png
SITE_ORG_NAME=Joszomszedseg
SITE_ORG_SLOGAN="Segíts a szomszédodnak!"
SITE_ORG_ADDRESS=
SITE_ORG_PHONE=
SITE_ORG_EMAIL=
SITE_FACEBOOK_PROFILE=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

VIRTUAL_HOST=joszomszedsag.local

# Production checklist:
# - APP_ENV=production, APP_DEBUG=false, strong APP_KEY (php artisan key:generate)
# - Unique DB_PASSWORD, SESSION_SECURE_COOKIE=true behind HTTPS
# - Never commit a real .env; rotate creds if Adminer/public dumps were ever exposed.
# - Existing pre-12 databases: ALTER TABLE users MODIFY password VARCHAR(255) NULL
#   (fresh installs already have nullable password).
